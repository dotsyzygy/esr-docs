{
  // Runs ./build.sh (Git Bash on Windows). --no-open because the launch config opens the browser.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build docs",
      "type": "process",
      "command": "bash",
      "windows": { "command": "C:\\Program Files\\Git\\bin\\bash.exe" },
      "args": ["./build.sh", "--no-open"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Build docs (pull both repos first)",
      "type": "process",
      "command": "bash",
      "windows": { "command": "C:\\Program Files\\Git\\bin\\bash.exe" },
      "args": ["./build.sh", "--pull", "--no-open"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
