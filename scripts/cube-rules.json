    {
      "match": "^Trap Damage Augmenter",
      "category": "mis",
      "title": "Trap Damage Augmenter"
    },
    {
      "match": "(^|\\s)trap(\\s|$)",
      "hide": true
    },
    {
      "match": "OLD \\(Delete later\\)",
      "hide": true
    },
    {
      "match": "^Check if already",
      "hide": true
    },
    {
      "match": "^(Unique|Set|Rare|Crafted|Low Quality|Normal|High Quality) Corruption",
      "hide": true
